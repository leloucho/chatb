# Configuración del servidor
PORT=3000
NODE_ENV=development

# Seguridad y acceso administrativo
AUTH_ENABLED=true
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS y límites
CORS_ORIGIN=http://localhost:4200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Configuración de Twilio WhatsApp
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# Token de verificación para webhooks
WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token_here

# Configuración de Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pedidos
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Configuración de archivos
FILE_STORAGE_DRIVER=local
S3_PUBLIC_BASE_URL=

# URLs del webhook para desarrollo local con ngrok
WEBHOOK_URL=https://your-ngrok-domain.ngrok.io/webhook/whatsapp
STATUS_WEBHOOK_URL=https://your-ngrok-domain.ngrok.io/webhook/status